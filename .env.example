# Copy to .env for local development. Never commit .env.
# Browser-safe (publishable) values, from Supabase > Project Settings > API.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Same values for server-side rendering.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only secrets. Set as Cloudflare Worker secrets in production, never as VITE_ variables.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret the scheduler sends as "Authorization: Bearer <secret>" to /api/public/jobs/sync-sources.
CRON_SECRET=
CRON_SECRET_PREVIOUS=
